{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mibBreak",
  "version": "0.1.0",
  "identifier": "io.github.mibbreak",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "mibBreak",
        "width": 1280,
        "height": 760,
        "minWidth": 480,
        "minHeight": 320,
        "backgroundColor": "#101114"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "shortDescription": "Camera viewer without vendor lock-in",
    "category": "Video"
  }
}
